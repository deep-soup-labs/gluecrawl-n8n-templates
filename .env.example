# Copy to `.env` (gitignored) before running the local instance.

# Pin the image once a template corpus exists — `latest` silently moves the
# editor version templates are exported from, and the export shape changes
# between majors.
N8N_VERSION=latest

GENERIC_TIMEZONE=Europe/Madrid

# Only needed for templates that use the Gluecrawl Trigger. The Gluecrawl API
# rejects webhook targets that are not https on a public IP, so the trigger
# cannot register while n8n believes it is on localhost — including on "Test
# workflow", which calls the same registration hook.
#
#   npm run n8n:tunnel        # prints https://<name>.trycloudflare.com
#   N8N_WEBHOOK_URL=https://<name>.trycloudflare.com npm run n8n:up
#
# Quick tunnels get a fresh hostname on every restart, so expect to re-register.
N8N_WEBHOOK_URL=

# --- Talking to the local editor from the terminal ---
#
# Create the key in the editor at Settings -> n8n API. Local throwaway instance
# only: this guards nothing but http://localhost:5678 on this machine.
#
# Two names for one host, because the two tools disagree: `@n8n/cli` reads
# N8N_URL, and the n8n MCP server reads N8N_API_URL. Keep them equal.
N8N_URL=http://localhost:5678
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
