    {
      "id": "b6f39c02-8a45-4d71-9e26-5b0d7f2a1c84",
      "name": "Write the Digest",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1888,
        556
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are a technology editor writing this week's AI newsletter for a busy technical audience.\n\nBelow are the stories published since the last edition, grouped by the site they came from. Each one carries an excerpt of the article itself, so write from what the reporting actually says rather than from the headline.\n\nWrite the edition as Markdown:\n\n- Open with a short paragraph naming the one development that mattered most this week and why.\n- Then group the rest into two to four themed sections with your own headings. Merge stories covering the same event into a single entry rather than repeating it per outlet.\n- Take the concrete detail from each excerpt — who shipped what, the numbers, who it affects. Do not pad with generalities the source did not state.\n- Link every story inline the first time you mention it, using its URL.\n- Skip press releases, funding rounds under $50M, and advertising.\n- Where an excerpt breaks off mid-sentence, work from what is there and do not guess at the rest.\n- Around 500 words. No preamble, no closing sign-off, no mention of these instructions.\n\nStories ({{ $json.article_count }} this week, from {{ $json.sources }}):\n\n{{ $json.brief }}",
        "batching": {}
      }
    },
