    {
      "id": "c3a70e59-6d82-4b14-8f97-2e5b1c9d4a06",
      "name": "Build the Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1664,
        556
      ],
      "parameters": {
        "jsCode": "// Collapse the week into a single item. The model has to see every story at\n// once to group them; one prompt per article would only ever produce a list.\nconst EXCERPT = 1200;\n\nconst articles = $input.all().map((item) => item.json);\n\nconst bySource = {};\nfor (const article of articles) {\n  (bySource[article.source] ??= []).push(article);\n}\n\nconst brief = Object.entries(bySource)\n  .map(([source, rows]) => {\n    const entries = rows.map((row) => {\n      const parts = [`### ${row.title}`, row.url];\n      if (row.published_at) parts.push(`Published: ${row.published_at}`);\n      if (row.body) parts.push(row.body.slice(0, EXCERPT));\n      return parts.join('\\n');\n    });\n    return `## ${source}\\n\\n${entries.join('\\n\\n')}`;\n  })\n  .join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      week_of: new Date().toISOString().slice(0, 10),\n      article_count: articles.length,\n      sources: Object.keys(bySource).join(', '),\n      brief,\n    },\n  },\n];"
      }
    },
